{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gnubodhi/Prometheus/blob/main/schemas/command_plan.schema.json",
  "title": "Prometheus command-plan proposal contract",
  "description": "Structural gate only. It does not prove command validity, privilege, threat model compliance or safety.",
  "type": "object",
  "required": [
    "schema_version",
    "goal",
    "mode",
    "host_evidence",
    "changes",
    "risk",
    "approval_required",
    "verification",
    "rollback"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "advisory",
        "read_only",
        "authorized_change"
      ]
    },
    "host_evidence": {
      "type": "object",
      "required": [
        "os",
        "effective_uid",
        "connection_type"
      ],
      "properties": {
        "os": {
          "type": "object",
          "required": [
            "status",
            "source"
          ],
          "properties": {
            "status": {
              "enum": [
                "observed",
                "version_matched_documentation",
                "assumed",
                "unknown"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "value": {},
            "tool_version": {
              "type": "string"
            },
            "timestamp": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "effective_uid": {
          "type": "object",
          "required": [
            "status",
            "source"
          ],
          "properties": {
            "status": {
              "enum": [
                "observed",
                "version_matched_documentation",
                "assumed",
                "unknown"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "value": {},
            "tool_version": {
              "type": "string"
            },
            "timestamp": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "connection_type": {
          "type": "object",
          "required": [
            "status",
            "source"
          ],
          "properties": {
            "status": {
              "enum": [
                "observed",
                "version_matched_documentation",
                "assumed",
                "unknown"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "value": {},
            "tool_version": {
              "type": "string"
            },
            "timestamp": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "firewall_backend": {
          "type": "object",
          "required": [
            "status",
            "source"
          ],
          "properties": {
            "status": {
              "enum": [
                "observed",
                "version_matched_documentation",
                "assumed",
                "unknown"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "value": {},
            "tool_version": {
              "type": "string"
            },
            "timestamp": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "init_system": {
          "type": "object",
          "required": [
            "status",
            "source"
          ],
          "properties": {
            "status": {
              "enum": [
                "observed",
                "version_matched_documentation",
                "assumed",
                "unknown"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "value": {},
            "tool_version": {
              "type": "string"
            },
            "timestamp": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "package_manager": {
          "type": "object",
          "required": [
            "status",
            "source"
          ],
          "properties": {
            "status": {
              "enum": [
                "observed",
                "version_matched_documentation",
                "assumed",
                "unknown"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "value": {},
            "tool_version": {
              "type": "string"
            },
            "timestamp": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "status",
          "source"
        ],
        "properties": {
          "status": {
            "enum": [
              "observed",
              "version_matched_documentation",
              "assumed",
              "unknown"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "value": {},
          "tool_version": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "operation",
          "target",
          "risk",
          "state_changing",
          "requires_approval",
          "evidence",
          "verification",
          "rollback"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "state_changing": {
            "type": "boolean"
          },
          "requires_approval": {
            "type": "boolean"
          },
          "approved": {
            "type": "boolean"
          },
          "requested": {
            "type": "boolean"
          },
          "implementation": {
            "type": "string"
          },
          "command": {
            "type": "string",
            "description": "Untrusted proposal; must never be executed solely because schema validation passes"
          },
          "parameters": {
            "type": "object"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "status",
                "source"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "observed",
                    "version_matched_documentation",
                    "assumed",
                    "unknown"
                  ]
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {},
                "tool_version": {
                  "type": "string"
                },
                "timestamp": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "preconditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "verification": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "rollback": {
            "type": "object",
            "required": [
              "method",
              "verified"
            ],
            "properties": {
              "method": {
                "type": "string",
                "minLength": 1
              },
              "verified": {
                "type": "boolean"
              },
              "artifact": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "approval_required": {
      "type": "boolean"
    },
    "approval_reference": {
      "type": "string"
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rollback": {
      "type": "object",
      "required": [
        "method",
        "verified"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "verified": {
          "type": "boolean"
        },
        "artifact": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "authorized_change"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "approval_required": {
            "const": true
          }
        },
        "required": [
          "approval_reference"
        ]
      }
    }
  ],
  "additionalProperties": false
}
