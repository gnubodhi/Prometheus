{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/gnubodhi/Prometheus/main/schemas/ports_rules.schema.json",
  "title": "Prometheus ports_rules.json schema v3",
  "type": "object",
  "required": [
    "name",
    "version",
    "default_policy",
    "rules",
    "port_rules"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "default_policy": {
      "type": "object"
    },
    "rules": {
      "type": "object"
    },
    "port_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "service",
          "role",
          "direction",
          "transport_endpoints",
          "default_inbound_action",
          "default_source_scope",
          "exposure_risk",
          "allow_inbound_when",
          "configuration_status",
          "verification",
          "reason",
          "exceptions",
          "service_specific_verification",
          "authentication_model"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "service": {
            "type": "string"
          },
          "role": {
            "enum": [
              "client",
              "server",
              "management",
              "discovery"
            ]
          },
          "direction": {
            "enum": [
              "inbound",
              "outbound",
              "bidirectional"
            ]
          },
          "transport_endpoints": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "port",
                "protocol",
                "typical_only"
              ],
              "properties": {
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "protocol": {
                  "enum": [
                    "tcp",
                    "udp",
                    "sctp"
                  ]
                },
                "typical_only": {
                  "const": true
                }
              },
              "additionalProperties": false
            }
          },
          "default_inbound_action": {
            "enum": [
              "deny",
              "conditional"
            ]
          },
          "default_source_scope": {
            "enum": [
              "none",
              "management_hosts",
              "trusted_lan_hosts",
              "application_hosts",
              "approved_peers",
              "loopback_first",
              "local_multicast",
              "dhcp_local"
            ]
          },
          "exposure_risk": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "allow_inbound_when": {
            "type": "string",
            "minLength": 20
          },
          "authentication_required": {
            "type": "boolean"
          },
          "requires_listener_verification": {
            "type": "boolean"
          },
          "requires_explicit_approval_for_public_exposure": {
            "type": "boolean"
          },
          "security_notes": {
            "type": "string"
          },
          "verification": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "configuration_status": {
            "const": "reference_not_observed"
          },
          "reason": {
            "type": "string",
            "minLength": 10
          },
          "exceptions": {
            "type": "string",
            "minLength": 10
          },
          "service_specific_verification": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "authentication_model": {
            "type": "string",
            "minLength": 3
          }
        },
        "additionalProperties": false
      }
    },
    "engineering_principles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "problem",
          "native_first",
          "avoid_by_default",
          "exceptions",
          "verification"
        ],
        "properties": {
          "problem": {
            "type": "string"
          },
          "native_first": {
            "type": "string"
          },
          "avoid_by_default": {
            "type": "string"
          },
          "exceptions": {
            "type": "string"
          },
          "verification": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "environment_profiles": {
      "type": "object"
    },
    "rule_decision_schema": {
      "type": "object"
    },
    "decision_workflow": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_requirements": {
      "type": "object"
    },
    "prohibited_assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_ref": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
